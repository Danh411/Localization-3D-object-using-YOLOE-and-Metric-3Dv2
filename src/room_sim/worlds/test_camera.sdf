<?xml version="1.0"?>
<!-- W1-A1/A2: thế giới thử tối thiểu: sàn, vài vật, camera rgbd 1280x720 hfov 70 deg, 10 Hz -->
<sdf version="1.9">
  <world name="test_camera">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry></collision>
        <visual name="v"><geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- tường phẳng cách camera 3 m (dùng kiểm tra z-depth sau này) -->
    <model name="wall">
      <static>true</static><pose>5 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.1 8 3</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.1 8 3</size></box></geometry>
          <material><ambient>0.8 0.6 0.4 1</ambient><diffuse>0.8 0.6 0.4 1</diffuse></material></visual>
      </link>
    </model>

    <model name="box_red">
      <static>true</static><pose>3.5 0.6 0.25 0 0 0.3</pose>
      <link name="link">
        <visual name="v"><geometry><box><size>0.4 0.4 0.5</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>
    <model name="cyl_blue">
      <static>true</static><pose>3.0 -0.8 0.3 0 0 0</pose>
      <link name="link">
        <visual name="v"><geometry><cylinder><radius>0.15</radius><length>0.6</length></cylinder></geometry>
          <material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material></visual>
      </link>
    </model>

    <!-- camera tại (2,0,1.2), nhìn theo +x -->
    <model name="camera_rig">
      <static>true</static><pose>2 0 1.2 0 0 0</pose>
      <link name="camera_link">
        <visual name="body"><geometry><box><size>0.06 0.1 0.06</size></box></geometry></visual>
        <sensor name="rgbd" type="rgbd_camera">
          <topic>camera</topic>
          <update_rate>10</update_rate>
          <always_on>true</always_on>
          <camera>
            <horizontal_fov>1.2217305</horizontal_fov> <!-- 70 deg -->
            <image><width>1280</width><height>720</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>10.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
